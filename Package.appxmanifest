<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/manifest/foundation/windows10/manifest"
    xmlns:u="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="u">
  <Identity
      Name="com.example.livestockmanager"
      Publisher="CN=YourPublisher"
      Version="1.0.0.0" />
  <Properties>
    <DisplayName>Livestock Manager</DisplayName>
    <PublisherName>YourPublisher</PublisherName>
    <PublisherUri>https://yourpublisher.example.com</PublisherUri>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Add required dependencies here -->
  </Dependencies>
  <Resources>
    <Resource Language="es-ES"/>
  </Resources>
  <Applications>
    <Application Id="App"
                 Executable="App.exe"
                 EntryPoint="App">
      <u:VisualElements DisplayName="Livestock Manager"
                        BackgroundColor="#FFFFFF">
        <u:Tile
            Square150x150Logo="Assets\StoreLogo.png"/>
      </u:VisualElements>
    </Application>
  </Applications>
</Package>